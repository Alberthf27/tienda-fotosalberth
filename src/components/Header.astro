---
import type { InfoTienda } from '../lib/catalogo/tipos';

interface Props {
  tienda: InfoTienda;
}

const { tienda } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-shadow duration-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- Marca / Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-hidden">
        <div class="w-10 h-10 rounded-xl bg-sky-600 flex items-center justify-center text-white shadow-md shadow-sky-600/20 group-hover:bg-sky-700 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
            <circle cx="12" cy="13" r="3"/>
          </svg>
        </div>
        <div>
          <span class="text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-sky-600 transition-colors">
            {tienda.nombre}
          </span>
          <span class="hidden sm:block text-xs font-medium text-slate-500">
            {tienda.ciudad} • Catálogo Oficial
          </span>
        </div>
      </a>

      <!-- Buscador en Vivo (Centro) -->
      <div class="flex-1 max-w-md mx-2">
        <div class="relative">
          <input
            type="search"
            id="buscador-productos"
            placeholder="Buscar cuadros, fotos, marcos..."
            autocomplete="off"
            class="w-full pl-10 pr-4 py-2 text-sm bg-slate-100 hover:bg-slate-200/70 focus:bg-white text-slate-900 placeholder-slate-400 rounded-full border border-transparent focus:border-sky-500 focus:outline-hidden transition-all duration-150"
          />
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Botón Abrir Carrito -->
      <button
        type="button"
        id="btn-abrir-carrito"
        aria-label="Abrir Carrito de compras"
        class="relative flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-sky-700 font-semibold text-sm transition-all focus:outline-hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="21" r="1"/>
          <circle cx="19" cy="21" r="1"/>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
        </svg>
        <span class="hidden md:inline">Carrito</span>
        <span
          id="badge-carrito-contador"
          class="inline-flex items-center justify-center min-w-[20px] h-5 px-1 text-xs font-bold text-white bg-sky-600 rounded-full transition-transform"
        >
          0
        </span>
      </button>

    </div>
  </div>
</header>

<script>
  // Conectar el buscador global con la página
  const inputBusqueda = document.getElementById('buscador-productos') as HTMLInputElement | null;
  inputBusqueda?.addEventListener('input', (e) => {
    const valor = (e.target as HTMLInputElement).value;
    window.dispatchEvent(new CustomEvent('catalogo:buscar', { detail: { query: valor } }));
  });

  // Conectar botón del carrito
  document.getElementById('btn-abrir-carrito')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  // Actualizar contador del header al recibir evento de carrito
  window.addEventListener('cart:change', ((e: CustomEvent) => {
    const contador = document.getElementById('badge-carrito-contador');
    if (contador) {
      const cantidad = e.detail?.totalItems || 0;
      contador.textContent = String(cantidad);
      contador.classList.remove('scale-125');
      void contador.offsetWidth; // trigger reflow
      contador.classList.add('scale-125');
      setTimeout(() => contador.classList.remove('scale-125'), 200);
    }
  }) as EventListener);
</script>
