---
import type { InfoTienda } from '../lib/catalogo/tipos';

interface Props {
  tienda: InfoTienda;
}

const { tienda } = Astro.props;
---

<!-- Overlay del Carrito -->
<div
  id="cart-overlay"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
>
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div
      id="cart-panel"
      class="w-screen max-w-md bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out"
      role="dialog"
      aria-modal="true"
      aria-label="Carrito de compras"
    >
      <!-- Cabecera del Carrito -->
      <div class="p-4 sm:p-5 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"/>
              <circle cx="19" cy="21" r="1"/>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900">Tu Carrito</h2>
            <p id="cart-item-count-label" class="text-xs text-slate-500">0 productos</p>
          </div>
        </div>

        <button
          type="button"
          id="btn-cerrar-carrito"
          class="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-200/60 transition-colors focus:outline-hidden"
          aria-label="Cerrar carrito"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Lista de Ítems (Scrollable) -->
      <div id="cart-items-container" class="flex-1 overflow-y-auto p-4 sm:p-5 divide-y divide-slate-100">
        <!-- Rellenado dinámicamente en cliente -->
        <div id="cart-empty-state" class="py-16 text-center">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"/>
              <circle cx="19" cy="21" r="1"/>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-800">El carrito está vacío</h3>
          <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">Explora nuestro catálogo y agrega los productos que deseas pedir.</p>
        </div>
      </div>

      <!-- Pie del Carrito: Totales y Finalizar Pedido -->
      <div id="cart-footer" class="p-4 sm:p-5 border-t border-slate-200 bg-slate-50/50 space-y-4">
        <!-- Opcional: Nombre del Cliente -->
        <div class="space-y-2">
          <label for="cliente-nombre-input" class="block text-xs font-semibold text-slate-600">
            Tu Nombre (opcional para el pedido):
          </label>
          <input
            type="text"
            id="cliente-nombre-input"
            placeholder="Ej: Juan Pérez"
            class="w-full px-3 py-1.5 text-xs bg-white border border-slate-300 rounded-lg focus:border-sky-500 focus:outline-hidden"
          />
        </div>

        <!-- Desglose de Precios -->
        <div class="space-y-1.5 pt-2 border-t border-slate-200">
          <div class="flex justify-between text-xs text-slate-500">
            <span>Subtotal estimado</span>
            <span id="cart-subtotal" class="font-mono">S/ 0.00</span>
          </div>
          <div class="flex justify-between text-base font-extrabold text-slate-900">
            <span>Total a Pagar</span>
            <span id="cart-total" class="font-mono text-sky-700">S/ 0.00</span>
          </div>
          <p class="text-[11px] text-slate-400">Coordinarás el pago y la entrega directamente por WhatsApp.</p>
        </div>

        <!-- Botón de WhatsApp -->
        <button
          type="button"
          id="btn-finalizar-whatsapp"
          disabled
          class="w-full py-3.5 px-4 rounded-xl text-white font-extrabold text-sm flex items-center justify-center gap-2.5 transition-all shadow-md bg-emerald-600 hover:bg-emerald-700 active:scale-98 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Pedir por WhatsApp
        </button>

        <button
          type="button"
          id="btn-vaciar-carrito"
          class="w-full text-center text-xs text-slate-400 hover:text-rose-600 transition-colors py-1 cursor-pointer"
        >
          Vaciar carrito
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ tienda }}>
  import {
    agregarProducto,
    actualizarCantidad,
    eliminarItem,
    calcularTotales
  } from '../lib/carrito/estado';
  import { generarEnlaceWhatsApp } from '../lib/pedido/mensaje';

  const STORAGE_KEY = 'fotosalberth_cart_v1';
  let carritoItems = [];

  function cargarCarrito() {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      carritoItems = data ? JSON.parse(data) : [];
    } catch {
      carritoItems = [];
    }
  }

  function guardarCarrito() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(carritoItems));
    } catch {}
    const estado = calcularTotales(carritoItems);
    window.dispatchEvent(new CustomEvent('cart:change', { detail: estado }));
    renderizarCarrito();
  }

  function abrirDrawer() {
    const overlay = document.getElementById('cart-overlay');
    const panel = document.getElementById('cart-panel');
    if (overlay && panel) {
      overlay.classList.remove('pointer-events-none', 'opacity-0');
      overlay.classList.add('opacity-100');
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
    }
  }

  function cerrarDrawer() {
    const overlay = document.getElementById('cart-overlay');
    const panel = document.getElementById('cart-panel');
    if (overlay && panel) {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
    }
  }

  function renderizarCarrito() {
    const container = document.getElementById('cart-items-container');
    const labelCount = document.getElementById('cart-item-count-label');
    const subtotalEl = document.getElementById('cart-subtotal');
    const totalEl = document.getElementById('cart-total');
    const btnWhatsApp = document.getElementById('btn-finalizar-whatsapp');
    const emptyState = document.getElementById('cart-empty-state');

    if (!container) return;

    const estado = calcularTotales(carritoItems);

    if (labelCount) labelCount.textContent = `${estado.totalItems} producto${estado.totalItems === 1 ? '' : 's'}`;
    if (subtotalEl) subtotalEl.textContent = `S/ ${estado.subtotal.toFixed(2)}`;
    if (totalEl) totalEl.textContent = `S/ ${estado.total.toFixed(2)}`;

    if (btnWhatsApp) {
      btnWhatsApp.disabled = estado.items.length === 0;
    }

    if (carritoItems.length === 0) {
      container.innerHTML = `
        <div class="py-16 text-center">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"/>
              <circle cx="19" cy="21" r="1"/>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-800">El carrito está vacío</h3>
          <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">Explora nuestro catálogo y agrega los productos que deseas pedir.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = carritoItems.map(item => `
      <div class="py-3.5 flex gap-3 items-center" data-item-id="${item.id}">
        <img
          src="${item.foto || 'https://images.unsplash.com/photo-1544816155-12df9643f363?w=200&auto=format&fit=crop&q=80'}"
          alt="${item.nombre}"
          class="w-16 h-16 rounded-xl object-cover bg-slate-100 border border-slate-200 shrink-0"
        />
        <div class="flex-1 min-w-0">
          <h4 class="text-xs font-bold text-slate-900 truncate">${item.nombre}</h4>
          <p class="text-[11px] text-slate-500 mt-0.5">S/ ${item.precio.toFixed(2)} c/u</p>
          
          <div class="flex items-center justify-between mt-2">
            <!-- Selector de Cantidad -->
            <div class="inline-flex items-center border border-slate-200 rounded-lg bg-white overflow-hidden shadow-2xs">
              <button
                type="button"
                data-action="dec"
                data-id="${item.id}"
                class="px-2 py-0.5 text-xs text-slate-600 hover:bg-slate-100 font-bold cursor-pointer"
              >−</button>
              <span class="px-2 text-xs font-bold text-slate-800 min-w-[20px] text-center">${item.cantidad}</span>
              <button
                type="button"
                data-action="inc"
                data-id="${item.id}"
                class="px-2 py-0.5 text-xs text-slate-600 hover:bg-slate-100 font-bold cursor-pointer"
              >+</button>
            </div>

            <!-- Subtotal y Eliminar -->
            <div class="flex items-center gap-3">
              <span class="text-xs font-black text-slate-900 font-mono">
                S/ ${(item.precio * item.cantidad).toFixed(2)}
              </span>
              <button
                type="button"
                data-action="remove"
                data-id="${item.id}"
                title="Eliminar producto"
                class="text-slate-400 hover:text-rose-600 p-1 rounded-md transition-colors cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    // Delegación de eventos para controles del carrito
    container.querySelectorAll('button[data-action]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = Number(btn.getAttribute('data-id'));
        const action = btn.getAttribute('data-action');
        const item = carritoItems.find(i => i.id === id);
        if (!item) return;

        if (action === 'dec') {
          carritoItems = actualizarCantidad(carritoItems, id, item.cantidad - 1);
        } else if (action === 'inc') {
          carritoItems = actualizarCantidad(carritoItems, id, item.cantidad + 1);
        } else if (action === 'remove') {
          carritoItems = eliminarItem(carritoItems, id);
        }
        guardarCarrito();
      });
    });
  }

  // Inicialización en carga de página
  document.addEventListener('DOMContentLoaded', () => {
    cargarCarrito();
    guardarCarrito();

    // Eventos de apertura / cierre
    window.addEventListener('cart:open', abrirDrawer);
    document.getElementById('btn-cerrar-carrito')?.addEventListener('click', cerrarDrawer);
    document.getElementById('cart-overlay')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) cerrarDrawer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarDrawer();
    });

    // Vaciar carrito
    document.getElementById('btn-vaciar-carrito')?.addEventListener('click', () => {
      if (carritoItems.length === 0) return;
      if (confirm('¿Deseas vaciar todos los productos del carrito?')) {
        carritoItems = [];
        guardarCarrito();
      }
    });

    // Evento para agregar producto desde cualquier tarjeta o página
    window.addEventListener('cart:add', ((e: CustomEvent) => {
      const prod = e.detail?.producto;
      const cant = e.detail?.cantidad || 1;
      if (!prod) return;

      const res = agregarProducto(carritoItems, prod, cant);
      if (res.error) {
        alert(res.error);
        return;
      }

      carritoItems = res.items;
      guardarCarrito();
      abrirDrawer();
    }) as EventListener);

    // Botón Finalizar por WhatsApp
    document.getElementById('btn-finalizar-whatsapp')?.addEventListener('click', () => {
      if (carritoItems.length === 0) return;
      const nombreInput = document.getElementById('cliente-nombre-input') as HTMLInputElement | null;
      const nombreCliente = nombreInput?.value?.trim() || '';

      const url = generarEnlaceWhatsApp(carritoItems, tienda, { nombre: nombreCliente });
      if (url) {
        window.open(url, '_blank');
      }
    });

    // Conectar botones "+ Agregar" de las tarjetas de producto
    document.querySelectorAll('[data-btn-agregar]').forEach(btn => {
      btn.addEventListener('click', () => {
        try {
          const raw = btn.getAttribute('data-producto');
          if (!raw) return;
          const producto = JSON.parse(raw);
          window.dispatchEvent(new CustomEvent('cart:add', { detail: { producto, cantidad: 1 } }));
        } catch (err) {
          console.error('Error agregando producto:', err);
        }
      });
    });
  });
</script>
