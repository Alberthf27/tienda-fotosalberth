---
import Layout from '../layouts/Layout.astro';
import { obtenerCatalogo } from '../lib/catalogo/snapshot';
import { construirTaxonomia } from '../lib/catalogo/taxonomia';

const catalogo = await obtenerCatalogo();
const { tienda, productos } = catalogo;
const taxonomia = construirTaxonomia(productos);
---

<Layout title="Página no encontrada (404)" tienda={tienda} taxonomia={taxonomia}>
  <div class="py-24 text-center max-w-md mx-auto space-y-4">
    <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 text-slate-800 flex items-center justify-center font-bold text-xl shadow-2xs">
      404
    </div>
    <h1 class="text-xl font-bold text-slate-900 tracking-tight">Página no encontrada</h1>
    <p class="text-xs text-slate-500">
      El producto o la sección que buscas ya no está disponible o el enlace ha cambiado.
    </p>
    <div class="pt-4">
      <a
        href="/"
        class="apple-press inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs shadow-sm transition-all"
      >
        Volver al Catálogo
      </a>
    </div>
  </div>
</Layout>
