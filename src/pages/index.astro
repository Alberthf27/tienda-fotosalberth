---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { obtenerCatalogo } from '../lib/catalogo/snapshot';
import { construirTaxonomia } from '../lib/catalogo/taxonomia';

const catalogo = await obtenerCatalogo();
const { tienda, categorias, productos } = catalogo;
const taxonomia = construirTaxonomia(productos);

const destacados = productos.filter(p => p.disponible).slice(0, 12);
---

<Layout
  title="Inicio"
  description={`Tienda de tecnología, fotografía e insumos en ${tienda.ciudad}. Precios en soles, stock real y pedidos por WhatsApp.`}
  tienda={tienda}
  taxonomia={taxonomia}
>
  <!-- Banner principal -->
  <section class="mb-8 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 rounded-2xl p-8 sm:p-12 text-white relative overflow-hidden" aria-label="Banner principal">
    <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><circle cx=%2230%22 cy=%2230%22 r=%221.5%22 fill=%22white%22/></svg>'); background-size: 24px;"></div>
    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-semibold mb-4 border border-emerald-500/30">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{tienda.ciudad} • {productos.length} productos en catálogo</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-4">
        Tecnología, Audio &<br class="hidden sm:block" /> Fotografía
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-xl mb-6">
        Catálogo completo con precios en soles y stock actualizado. Pide directo por WhatsApp con entrega a domicilio o recojo en taller.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#departamentos" class="px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-sm transition-colors shadow-lg">
          Ver Departamentos
        </a>
        <a href="#destacados" class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl text-sm backdrop-blur-sm border border-white/10 transition-colors">
          Productos Destacados
        </a>
      </div>
    </div>
  </section>

  <!-- Garantías -->
  <section class="mb-10 grid grid-cols-2 md:grid-cols-4 gap-3" aria-label="Garantías">
    {[
      { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', title: 'Garantía en Taller', sub: 'Prueba y compatibilidad' },
      { icon: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10', title: 'Recojo en Taller', sub: 'Sin costo de envío' },
      { icon: 'M1 3h15v13H1z M16 8h4l3 3v5h-7V8z M5.5 18.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M18.5 18.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z', title: 'Envíos en Trujillo', sub: 'A domicilio o trabajo' },
      { icon: 'M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4 M4 6v12c0 1.1.9 2 2 2h14v-4 M18 12a2 2 0 0 0 0 4h4v-4h-4z', title: 'Yape, Plin y BCP', sub: 'Pagos directos seguros' }
    ].map(g => (
      <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-700">
            <path d={g.icon}></path>
          </svg>
        </div>
        <div>
          <div class="font-bold text-slate-900 text-sm">{g.title}</div>
          <div class="text-xs text-slate-500">{g.sub}</div>
        </div>
      </div>
    ))}
  </section>

  <!-- Departamentos / Categorías -->
  <section id="departamentos" class="mb-12" aria-label="Departamentos">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold text-slate-900">Departamentos</h2>
      <span class="text-xs text-slate-500">{categorias.length} categorías</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {taxonomia.map(cat => (
        <a
          href={`/categoria/${cat.slug}`}
          class="group bg-white border border-slate-200 rounded-xl p-4 hover:border-emerald-500 hover:shadow-md transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </div>
          <div class="font-semibold text-slate-900 text-sm leading-tight mb-1">{cat.nombreCorto}</div>
          <div class="text-xs text-slate-500">{cat.total} productos</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Búsquedas rápidas -->
  <section class="mb-8 flex flex-wrap items-center gap-2" aria-label="Búsquedas populares">
    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide mr-1">Populares:</span>
    {['Audífono', 'Cable', 'Cargador', 'Memoria', 'Mouse', 'Tinta', 'Parlante', 'Pila'].map(t => (
      <button
        type="button"
        data-busqueda-rapida={t}
        class="px-3 py-1.5 bg-white border border-slate-200 rounded-full text-xs font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors cursor-pointer"
      >
        {t}
      </button>
    ))}
  </section>

  <!-- Productos destacados -->
  <section id="destacados" class="mb-12" aria-label="Productos destacados">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold text-slate-900">Productos Destacados</h2>
      <a href="/categoria/audifonos" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">Ver catálogo completo →</a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {destacados.map(prod => (
        <ProductCard producto={prod} simbolo={tienda.simbolo} />
      ))}
    </div>
  </section>

  <!-- Catálogo completo con filtros -->
  <section class="mb-12" aria-label="Catálogo completo">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
      <h2 class="text-xl font-bold text-slate-900">Todo el Catálogo</h2>
      <div class="flex flex-wrap items-center gap-2">
        <select id="filtro-precio" class="text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white text-slate-700 cursor-pointer">
          <option value="todos">Todos los precios</option>
          <option value="hasta-10">Hasta S/ 10</option>
          <option value="10-30">S/ 10 – S/ 30</option>
          <option value="30-60">S/ 30 – S/ 60</option>
          <option value="mas-60">Más de S/ 60</option>
        </select>
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
          <input type="checkbox" id="filtro-stock" class="rounded text-emerald-600" />
          <span>Solo en stock</span>
        </label>
        <select id="filtro-orden" class="text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white text-slate-700 cursor-pointer">
          <option value="destacados">Relevancia</option>
          <option value="precio-menor">Precio: Menor a Mayor</option>
          <option value="precio-mayor">Precio: Mayor a Menor</option>
          <option value="nombre">Nombre: A – Z</option>
        </select>
      </div>
    </div>

    <!-- Chips de categorías -->
    <div class="flex flex-wrap gap-2 mb-5" id="chips-categorias">
      <button type="button" data-chip="todas" class="chip-activa px-4 py-2 rounded-lg text-sm font-semibold bg-slate-900 text-white">
        Todos ({productos.length})
      </button>
      {taxonomia.map(cat => (
        <button
          type="button"
          data-chip={cat.slug}
          class="px-4 py-2 rounded-lg text-sm font-medium bg-white border border-slate-200 text-slate-700 hover:bg-slate-50"
        >
          {cat.nombreCorto} ({cat.total})
        </button>
      ))}
    </div>

    <div id="contador" class="text-sm text-slate-500 mb-4">Mostrando {productos.length} productos</div>

    <div id="grilla" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {productos.map(prod => (
        <ProductCard producto={prod} simbolo={tienda.simbolo} />
      ))}
    </div>

    <div id="sin-resultados" class="hidden py-16 text-center bg-white rounded-2xl border border-slate-200">
      <p class="text-slate-500 mb-4">No se encontraron productos con esos filtros.</p>
      <button type="button" id="btn-limpiar" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-semibold cursor-pointer">
        Limpiar filtros
      </button>
    </div>
  </section>

  <!-- Servicios del taller -->
  <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8" aria-label="Servicios del taller">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl font-bold text-slate-900">Servicios del Taller</h2>
        <p class="text-sm text-slate-500 mt-1">Fotografía profesional, marcos e impresiones en Trujillo.</p>
      </div>
      <a
        href={`https://wa.me/${tienda.telefono_whatsapp}?text=Hola%20FotosAlberth%2C%20quisiera%20cotizar%20un%20servicio`}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-sm transition-colors"
      >
        Cotizar por WhatsApp
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { t: 'Fotos Carnet & Pasaporte', d: 'Tomas biométricas instantáneas con fondo blanco oficial.' },
        { t: 'Cuadros & Enmarcados', d: 'Marcos en madera y vidrio a medida (20x30, retratos, diplomas).' },
        { t: 'Impresión & Copias', d: 'Documentos en B/N y color de alta resolución láser.' },
        { t: 'Anillados & Plastificados', d: 'Acabados para manuales, credenciales y documentos.' }
      ].map(s => (
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <div class="font-bold text-slate-900 text-sm mb-1">{s.t}</div>
          <p class="text-xs text-slate-500">{s.d}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script define:vars={{ taxonomiaData: taxonomia, tiendaData: tienda }}>
  const TAXONOMIA = taxonomiaData;
  const SIMBOLO = tiendaData.simbolo || 'S/';

  const grilla = document.getElementById('grilla');
  const contador = document.getElementById('contador');
  const sinResultados = document.getElementById('sin-resultados');
  const selectPrecio = document.getElementById('filtro-precio');
  const checkStock = document.getElementById('filtro-stock');
  const selectOrden = document.getElementById('filtro-orden');
  const chips = document.querySelectorAll('[data-chip]');
  const tarjetas = Array.from(document.querySelectorAll('.tarjeta-producto'));
  const inputBuscador = document.getElementById('buscador-productos');

  let categoriaActual = 'todas';
  let precioActual = 'todos';
  let soloStock = false;
  let ordenActual = 'destacados';
  let busquedaActual = '';

  function aplicarFiltros() {
    let visibles = 0;
    const query = busquedaActual.toLowerCase().trim();

    const slugify = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

    tarjetas.forEach(t => {
      const catNombre = t.getAttribute('data-categoria-nombre') || '';
      const cat = slugify(catNombre);
      const nombre = (t.getAttribute('data-nombre') || '').toLowerCase();
      const sku = (t.getAttribute('data-sku') || '').toLowerCase();
      const stock = Number(t.getAttribute('data-stock') || 0);
      const precio = Number(t.getAttribute('data-precio') || 0);

      const okCat = categoriaActual === 'todas' || cat === categoriaActual;
      const okBusq = !query || nombre.includes(query) || sku.includes(query);
      const okStock = !soloStock || stock > 0;
      let okPrecio = true;
      if (precioActual === 'hasta-10') okPrecio = precio <= 10;
      else if (precioActual === '10-30') okPrecio = precio > 10 && precio <= 30;
      else if (precioActual === '30-60') okPrecio = precio > 30 && precio <= 60;
      else if (precioActual === 'mas-60') okPrecio = precio > 60;

      if (okCat && okBusq && okStock && okPrecio) {
        t.style.display = '';
        visibles++;
      } else {
        t.style.display = 'none';
      }
    });

    // Orden
    if (grilla && ordenActual !== 'destacados') {
      const arr = Array.from(grilla.children);
      arr.sort((a, b) => {
        const pA = Number(a.getAttribute('data-precio') || 0);
        const pB = Number(b.getAttribute('data-precio') || 0);
        const nA = a.getAttribute('data-nombre') || '';
        const nB = b.getAttribute('data-nombre') || '';
        if (ordenActual === 'precio-menor') return pA - pB;
        if (ordenActual === 'precio-mayor') return pB - pA;
        if (ordenActual === 'nombre') return nA.localeCompare(nB);
        return 0;
      });
      arr.forEach(el => grilla.appendChild(el));
    }

    if (contador) contador.textContent = `Mostrando ${visibles} producto${visibles === 1 ? '' : 's'}`;
    if (sinResultados && grilla) {
      if (visibles === 0) {
        sinResultados.classList.remove('hidden');
        grilla.classList.add('hidden');
      } else {
        sinResultados.classList.add('hidden');
        grilla.classList.remove('hidden');
      }
    }
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      categoriaActual = chip.getAttribute('data-chip') || 'todas';
      chips.forEach(c => {
        c.classList.remove('bg-slate-900', 'text-white', 'chip-activa');
        c.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-700');
      });
      chip.classList.add('bg-slate-900', 'text-white', 'chip-activa');
      chip.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-700');
      aplicarFiltros();
    });
  });

  selectPrecio?.addEventListener('change', e => { precioActual = e.target.value; aplicarFiltros(); });
  checkStock?.addEventListener('change', e => { soloStock = e.target.checked; aplicarFiltros(); });
  selectOrden?.addEventListener('change', e => { ordenActual = e.target.value; aplicarFiltros(); });

  document.querySelectorAll('[data-busqueda-rapida]').forEach(btn => {
    btn.addEventListener('click', () => {
      busquedaActual = btn.getAttribute('data-busqueda-rapida') || '';
      if (inputBuscador) inputBuscador.value = busquedaActual;
      aplicarFiltros();
      document.getElementById('destacados')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  window.addEventListener('catalogo:buscar', e => {
    busquedaActual = e.detail?.query || '';
    aplicarFiltros();
  });

  document.getElementById('btn-limpiar')?.addEventListener('click', () => {
    busquedaActual = '';
    soloStock = false;
    ordenActual = 'destacados';
    precioActual = 'todos';
    categoriaActual = 'todas';
    if (inputBuscador) inputBuscador.value = '';
    if (checkStock) checkStock.checked = false;
    if (selectOrden) selectOrden.value = 'destacados';
    if (selectPrecio) selectPrecio.value = 'todos';
    chips.forEach(c => {
      c.classList.remove('bg-slate-900', 'text-white', 'chip-activa');
      c.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-700');
    });
    const todas = document.querySelector('[data-chip="todas"]');
    if (todas) {
      todas.classList.add('bg-slate-900', 'text-white', 'chip-activa');
      todas.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-700');
    }
    aplicarFiltros();
  });
</script>
