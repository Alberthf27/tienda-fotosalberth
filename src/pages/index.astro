---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { obtenerCatalogo } from '../lib/catalogo/snapshot';
import { construirTaxonomia } from '../lib/catalogo/taxonomia';

const catalogo = await obtenerCatalogo();
const { tienda, categorias, productos } = catalogo;
const taxonomia = construirTaxonomia(productos);

// Búsquedas populares en tecnología minorista
const terminosPopulares = [
  'Cable tipo C',
  'Audífono Bluetooth',
  'Memoria USB',
  'Tinta Epson',
  'Parlante recargable',
  'Mouse gamer',
  'Cargador rápido',
  'Pilas alcalinas',
  'Calculadora científica'
];
---

<Layout
  title="Tienda de Tecnología y Catálogo Oficial"
  description={`Catálogo oficial de tecnología, computación, fotografía e insumos en ${tienda.ciudad}. Precios en Soles y Dólares, stock real y compras por WhatsApp.`}
  tienda={tienda}
  taxonomia={taxonomia}
>
  <!-- 1. Bloque Principal Sercoplus: Menú Vertical de Categorías + Banner Principal -->
  <section class="mb-8" aria-label="Vitrina Principal">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
      
      <!-- Columna Izquierda: Menú Vertical Sercoplus (Visible en Desktop) -->
      <div class="hidden lg:block lg:col-span-3 bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs">
        <div class="bg-[#e52e2e] text-white px-4 py-3 font-black text-xs uppercase tracking-wider flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span>☰</span>
            <span>DEPARTAMENTOS</span>
          </div>
          <span class="text-[10px] bg-red-800 px-1.5 py-0.5 rounded font-mono">18</span>
        </div>
        
        <div class="p-1.5 divide-y divide-slate-100 max-h-[420px] overflow-y-auto scrollbar-none">
          <button
            type="button"
            data-filtro-sidebar="todas"
            class="item-sidebar-cat active w-full flex items-center justify-between px-3 py-2 rounded-lg text-left text-xs font-bold transition-colors cursor-pointer bg-red-50 text-[#e52e2e]"
          >
            <span>Todos los Departamentos</span>
            <span class="text-[10px] bg-red-100 text-[#e52e2e] px-1.5 py-0.5 rounded font-mono">487</span>
          </button>

          {taxonomia.slice(0, 10).map(cat => (
            <button
              type="button"
              data-filtro-sidebar={String(cat.id)}
              class="item-sidebar-cat w-full flex items-center justify-between px-3 py-2 rounded-lg text-left text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#e52e2e] transition-colors cursor-pointer"
            >
              <span class="truncate pr-1">{cat.nombreCorto}</span>
              <span class="text-[10px] text-slate-400 font-mono shrink-0">({cat.total})</span>
            </button>
          ))}
        </div>

        <div class="p-2 border-t border-slate-100 bg-slate-50 text-center">
          <button
            type="button"
            id="btn-ver-todas-categorias-sidebar"
            class="text-[11px] font-bold text-[#e52e2e] hover:underline cursor-pointer"
          >
            + Ver todas las 18 categorías
          </button>
        </div>
      </div>

      <!-- Columna Derecha: Banner Promocional Sercoplus + Garantías -->
      <div class="lg:col-span-9 flex flex-col justify-between gap-4">
        
        <!-- Banner Principal de Tienda Sercoplus -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-[#0e3e7a] text-white rounded-xl p-6 sm:p-8 relative overflow-hidden shadow-sm flex flex-col justify-between min-h-[250px]">
          <div class="absolute right-0 top-0 bottom-0 w-1/2 opacity-10 bg-no-repeat bg-right" style="background-image: radial-gradient(circle, #fff 10%, transparent 10%); background-size: 16px 16px;"></div>

          <div class="relative z-10 max-w-xl">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#e52e2e] text-white text-[11px] font-black uppercase tracking-wider mb-3">
              <span>★ CATÁLOGO OFICIAL 2026</span>
            </div>
            
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight leading-tight mb-2">
              Tecnología, Cómputo & Audio en Trujillo
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
              487 productos con stock físico garantizado. Compara precios en Soles y Dólares, arma tu pedido y recíbelo hoy mismo por WhatsApp.
            </p>

            <div class="flex flex-wrap gap-2.5">
              <a href="#catalogo" class="px-5 py-2.5 bg-[#ffd741] hover:bg-[#f59e0b] text-slate-950 font-black text-xs rounded-lg uppercase tracking-wider transition-colors shadow-xs">
                Explorar Productos
              </a>
              <a href={`https://wa.me/${tienda.telefono_whatsapp}`} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white font-bold text-xs rounded-lg uppercase tracking-wider backdrop-blur-xs border border-white/20 transition-colors">
                Asesor por WhatsApp
              </a>
            </div>
          </div>
        </div>

        <!-- Franja de 4 Garantías Oficiales Sercoplus -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
          <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center gap-2.5 shadow-2xs">
            <div class="w-8 h-8 rounded-lg bg-red-50 text-[#e52e2e] flex items-center justify-center font-bold text-sm shrink-0">
              🛡️
            </div>
            <div>
              <div class="font-bold text-slate-900 leading-tight">Garantía en Taller</div>
              <div class="text-[10px] text-slate-400 mt-0.5">Probado y compatible</div>
            </div>
          </div>

          <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center gap-2.5 shadow-2xs">
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0">
              🏬
            </div>
            <div>
              <div class="font-bold text-slate-900 leading-tight">Recojo en Tienda</div>
              <div class="text-[10px] text-slate-400 mt-0.5">Sin costo en taller</div>
            </div>
          </div>

          <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center gap-2.5 shadow-2xs">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-sm shrink-0">
              🛵
            </div>
            <div>
              <div class="font-bold text-slate-900 leading-tight">Envíos en Trujillo</div>
              <div class="text-[10px] text-slate-400 mt-0.5">A domicilio o trabajo</div>
            </div>
          </div>

          <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center gap-2.5 shadow-2xs">
            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center font-bold text-sm shrink-0">
              💳
            </div>
            <div>
              <div class="font-bold text-slate-900 leading-tight">Yape, Plin y BCP</div>
              <div class="text-[10px] text-slate-400 mt-0.5">Pagos directos seguros</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. Búsquedas Sugeridas Rápidas -->
  <section class="mb-6 flex items-center gap-2 overflow-x-auto pb-1 text-xs scrollbar-none" aria-label="Términos frecuentes">
    <span class="font-black text-slate-500 uppercase tracking-wider text-[10px] shrink-0">
      MÁS BUSCADO:
    </span>
    {terminosPopulares.map(t => (
      <button
        type="button"
        data-quick-search={t}
        class="px-2.5 py-1 rounded bg-white hover:bg-red-50 text-slate-700 hover:text-[#e52e2e] border border-slate-200 text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer"
      >
        {t}
      </button>
    ))}
  </section>

  <!-- 3. Barra de Control del Catálogo y Filtros Sercoplus -->
  <section id="catalogo" class="mb-6 bg-white rounded-xl border border-slate-200 p-4 shadow-xs" aria-label="Catálogo y Filtros">
    
    <!-- Fila 1: Pestañas de Filtro Rápido Sercoplus -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-slate-100">
      
      <!-- Pestañas Tipo Sercoplus -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none" id="tabs-sercoplus">
        <button
          type="button"
          data-tab-filtro="todos"
          class="tab-filtro-btn active px-3.5 py-1.5 rounded-lg text-xs font-black uppercase transition-all bg-[#e52e2e] text-white cursor-pointer whitespace-nowrap"
        >
          ★ Todos ({productos.length})
        </button>
        <button
          type="button"
          data-tab-filtro="ofertas"
          class="tab-filtro-btn px-3 py-1.5 rounded-lg text-xs font-bold uppercase transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer whitespace-nowrap"
        >
          🔥 En Oferta
        </button>
        <button
          type="button"
          data-tab-filtro="stock"
          class="tab-filtro-btn px-3 py-1.5 rounded-lg text-xs font-bold uppercase transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer whitespace-nowrap"
        >
          ✔ Mayor Stock
        </button>
        <button
          type="button"
          data-tab-filtro="economicos"
          class="tab-filtro-btn px-3 py-1.5 rounded-lg text-xs font-bold uppercase transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer whitespace-nowrap"
        >
          💰 Hasta S/ 20
        </button>
      </div>

      <!-- Controles de Orden y Precio -->
      <div class="flex flex-wrap items-center gap-2">
        <select
          id="filtro-rango-precio"
          class="text-xs font-bold text-slate-700 bg-slate-50 hover:bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 focus:outline-hidden cursor-pointer"
        >
          <option value="todos">Todos los precios</option>
          <option value="hasta-10">Hasta S/ 10</option>
          <option value="10-30">S/ 10 a S/ 30</option>
          <option value="30-60">S/ 30 a S/ 60</option>
          <option value="mas-60">Más de S/ 60</option>
        </select>

        <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 cursor-pointer">
          <input type="checkbox" id="filtro-solo-stock" class="rounded text-[#e52e2e] cursor-pointer" />
          <span>Solo en stock</span>
        </label>

        <select
          id="selector-orden"
          class="text-xs font-bold text-slate-700 bg-slate-50 hover:bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 focus:outline-hidden cursor-pointer"
        >
          <option value="destacados">Destacados</option>
          <option value="precio-menor">Precio: Menor a Mayor</option>
          <option value="precio-mayor">Precio: Mayor a Menor</option>
          <option value="nombre">Nombre: A - Z</option>
          <option value="stock">Mayor Stock</option>
        </select>
      </div>
    </div>

    <!-- Fila 2: Breadcrumbs de Navegación Activa -->
    <div class="pt-3 flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-2 flex-wrap text-slate-500 font-medium">
        <span>Ubicación:</span>
        <button
          type="button"
          id="breadcrumb-inicio"
          class="font-bold text-slate-900 hover:text-[#e52e2e] cursor-pointer"
        >
          Todos los Departamentos
        </button>
        <span id="breadcrumb-sep-1" class="text-slate-300 hidden">›</span>
        <button
          type="button"
          id="breadcrumb-cat"
          class="font-bold text-[#e52e2e] hidden cursor-pointer"
        >
        </button>
        <span id="breadcrumb-sep-2" class="text-slate-300 hidden">›</span>
        <span id="breadcrumb-sub" class="font-bold text-slate-700 hidden"></span>

        <button
          type="button"
          id="btn-limpiar-filtro-activo"
          class="hidden ml-2 px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-bold cursor-pointer"
        >
          ✕ Quitar filtro
        </button>
      </div>

      <div id="contador-productos-visibles" class="font-bold text-slate-700 text-xs">
        Mostrando {productos.length} productos
      </div>
    </div>

    <!-- Fila 3: Subcategorías Desplegadas Naturalmente de la Categoría Activa -->
    <div id="contenedor-subcategorias-chips" class="pt-3 border-t border-slate-100 mt-2">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none" id="lista-subcategorias-chips">
        <!-- Renderizado dinámico -->
      </div>
    </div>

  </section>

  <!-- 4. Grilla de Productos Oficial Sercoplus (4-5 Columnas) -->
  <section aria-label="Listado de productos">
    <div
      id="grilla-productos"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-3.5"
    >
      {productos.map(prod => (
        <ProductCard producto={prod} simbolo={tienda.simbolo} />
      ))}
    </div>

    <!-- Estado Vacío -->
    <div id="busqueda-sin-resultados" class="hidden py-16 text-center bg-white rounded-xl border border-slate-200 shadow-xs mt-4">
      <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center font-bold text-xl">
        🔍
      </div>
      <h3 class="text-sm font-bold text-slate-900">No encontramos productos coincidentes</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
        Prueba con otro término de búsqueda o selecciona otra categoría en el menú superior.
      </p>
      <button
        type="button"
        id="btn-limpiar-filtros-vacio"
        class="mt-4 px-4 py-2 rounded-lg text-xs font-bold bg-[#e52e2e] text-white cursor-pointer shadow-xs"
      >
        Ver todos los productos (487)
      </button>
    </div>
  </section>

  <!-- 5. Sección de Taller y Fotografía en Trujillo -->
  <section id="taller" class="mt-16 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs" aria-label="Servicios del Taller">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-slate-100">
      <div>
        <span class="inline-block px-2.5 py-0.5 rounded bg-blue-50 text-blue-700 font-bold text-[11px] mb-1.5 uppercase">
          Taller Oficial en Trujillo
        </span>
        <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
          Servicios de Fotografía Profesional, Marcos & Imprenta
        </h2>
        <p class="text-xs text-slate-500 mt-0.5 max-w-xl">
          Atención física en taller con más de una década de experiencia. Fotos tamaño carnet/pasaporte, cuadros a medida e impresiones láser de alta definición.
        </p>
      </div>

      <a
        href={`https://wa.me/${tienda.telefono_whatsapp}?text=Hola%20FotosAlberth%2C%20quisiera%20cotizar%20un%20servicio%20de%20fotograf%C3%ADa`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-2.5 rounded-lg bg-[#e52e2e] hover:bg-[#cc1818] text-white font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition-colors shadow-xs"
      >
        <span>Cotizar por WhatsApp</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-6 text-xs">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <div class="font-bold text-slate-900 text-sm mb-1">📷 Fotos Carnet y Pasaporte</div>
        <p class="text-slate-500 text-[11px]">Medidas biométricas oficiales para DNI, pasaporte y visas.</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <div class="font-bold text-slate-900 text-sm mb-1">🖼️ Cuadros y Enmarcados</div>
        <p class="text-slate-500 text-[11px]">Marcos de madera y vidrio a medida (20x30, 30x40 y diplomas).</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <div class="font-bold text-slate-900 text-sm mb-1">🖨️ Impresión y Copias</div>
        <p class="text-slate-500 text-[11px]">Documentos láser color y B/N en alta resolución.</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <div class="font-bold text-slate-900 text-sm mb-1">📑 Anillados y Plastificados</div>
        <p class="text-slate-500 text-[11px]">Acabados escolares, universitarios y corporativos.</p>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ taxonomiaData: taxonomia }}>
  const TAXONOMIA = taxonomiaData;

  // Estado del Catálogo
  let filtroCategoriaActual = 'todas';
  let filtroSubcategoriaActual = '';
  let terminoBusquedaActual = '';
  let tabActual = 'todos';
  let soloStockActual = false;
  let ordenActual = 'destacados';
  let rangoPrecioActual = 'todos';

  const grilla = document.getElementById('grilla-productos');
  const contadorVisibles = document.getElementById('contador-productos-visibles');
  const sinResultados = document.getElementById('busqueda-sin-resultados');
  const checkSoloStock = document.getElementById('filtro-solo-stock');
  const selectOrden = document.getElementById('selector-orden');
  const selectPrecio = document.getElementById('filtro-rango-precio');
  const inputBuscador = document.getElementById('buscador-productos');

  const bInicio = document.getElementById('breadcrumb-inicio');
  const bSep1 = document.getElementById('breadcrumb-sep-1');
  const bCat = document.getElementById('breadcrumb-cat');
  const bSep2 = document.getElementById('breadcrumb-sep-2');
  const bSub = document.getElementById('breadcrumb-sub');
  const btnLimpiarActivo = document.getElementById('btn-limpiar-filtro-activo');
  const listaSubChips = document.getElementById('lista-subcategorias-chips');

  const tarjetas = Array.from(document.querySelectorAll('.tarjeta-producto'));

  function actualizarBreadcrumbs() {
    if (filtroCategoriaActual === 'todas' && !filtroSubcategoriaActual) {
      bSep1?.classList.add('hidden');
      bCat?.classList.add('hidden');
      bSep2?.classList.add('hidden');
      bSub?.classList.add('hidden');
      btnLimpiarActivo?.classList.add('hidden');
    } else {
      btnLimpiarActivo?.classList.remove('hidden');

      const catObj = TAXONOMIA.find(c => String(c.id) === filtroCategoriaActual);
      if (catObj && bCat) {
        bCat.textContent = catObj.nombreCorto;
        bCat.classList.remove('hidden');
        bSep1?.classList.remove('hidden');
      }

      if (filtroSubcategoriaActual && bSub) {
        bSub.textContent = filtroSubcategoriaActual;
        bSub.classList.remove('hidden');
        bSep2?.classList.remove('hidden');
      } else {
        bSub?.classList.add('hidden');
        bSep2?.classList.add('hidden');
      }
    }
  }

  function actualizarSubcategoriasChips() {
    if (!listaSubChips) return;
    listaSubChips.innerHTML = '';

    if (filtroCategoriaActual === 'todas') {
      const btnTodos = document.createElement('button');
      btnTodos.className = 'px-3 py-1 rounded text-xs font-bold bg-[#e52e2e] text-white cursor-pointer whitespace-nowrap shadow-2xs';
      btnTodos.textContent = `Todos (${tarjetas.length})`;
      btnTodos.onclick = () => fijarFiltro('todas', '');
      listaSubChips.appendChild(btnTodos);

      TAXONOMIA.slice(0, 10).forEach(cat => {
        const btn = document.createElement('button');
        btn.className = 'px-3 py-1 rounded text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer whitespace-nowrap border border-slate-200';
        btn.innerHTML = `${cat.nombreCorto} <span class="text-slate-400 font-mono text-[10px]">(${cat.total})</span>`;
        btn.onclick = () => fijarFiltro(String(cat.id), '');
        listaSubChips.appendChild(btn);
      });
    } else {
      const catObj = TAXONOMIA.find(c => String(c.id) === filtroCategoriaActual);
      if (!catObj) return;

      const btnCatTodo = document.createElement('button');
      const isAll = !filtroSubcategoriaActual;
      btnCatTodo.className = `px-3 py-1 rounded text-xs font-bold cursor-pointer whitespace-nowrap ${isAll ? 'bg-[#e52e2e] text-white shadow-2xs' : 'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200'}`;
      btnCatTodo.textContent = `Todo ${catObj.nombreCorto} (${catObj.total})`;
      btnCatTodo.onclick = () => fijarFiltro(String(catObj.id), '');
      listaSubChips.appendChild(btnCatTodo);

      catObj.subcategorias.forEach(sub => {
        const btn = document.createElement('button');
        const isActive = filtroSubcategoriaActual === sub.nombre;
        btn.className = `px-2.5 py-1 rounded text-xs font-semibold cursor-pointer whitespace-nowrap ${isActive ? 'bg-slate-900 text-white font-bold' : 'bg-white text-slate-700 hover:bg-red-50 hover:text-[#e52e2e] border border-slate-200'}`;
        btn.innerHTML = `${sub.nombre} <span class="font-mono text-[10px] ${isActive ? 'text-slate-300' : 'text-slate-400'}">(${sub.total})</span>`;
        btn.onclick = () => fijarFiltro(String(catObj.id), sub.nombre);
        listaSubChips.appendChild(btn);
      });
    }
  }

  function aplicarFiltrosYOrden() {
    let visibles = 0;
    const query = terminoBusquedaActual.toLowerCase().trim();

    tarjetas.forEach(tarjeta => {
      const catId = tarjeta.getAttribute('data-categoria-id');
      const subNom = tarjeta.getAttribute('data-subcategoria') || '';
      const nombre = tarjeta.getAttribute('data-nombre') || '';
      const sku = tarjeta.getAttribute('data-sku') || '';
      const stock = Number(tarjeta.getAttribute('data-stock') || 0);
      const precio = Number(tarjeta.getAttribute('data-precio') || 0);

      const coincideCategoria = filtroCategoriaActual === 'todas' || catId === filtroCategoriaActual;
      const coincideSubcategoria = !filtroSubcategoriaActual || subNom === filtroSubcategoriaActual;
      const coincideBusqueda = !query || nombre.includes(query) || sku.includes(query) || subNom.toLowerCase().includes(query);
      const coincideStock = !soloStockActual || stock > 0;

      // Filtro de pestaña Sercoplus
      let coincideTab = true;
      if (tabActual === 'ofertas') coincideTab = tarjeta.querySelector('.serco-flag-sale') !== null;
      else if (tabActual === 'stock') coincideTab = stock > 3;
      else if (tabActual === 'economicos') coincideTab = precio <= 20;

      // Filtro de rango de precio
      let coincidePrecio = true;
      if (rangoPrecioActual === 'hasta-10') coincidePrecio = precio <= 10;
      else if (rangoPrecioActual === '10-30') coincidePrecio = precio > 10 && precio <= 30;
      else if (rangoPrecioActual === '30-60') coincidePrecio = precio > 30 && precio <= 60;
      else if (rangoPrecioActual === 'mas-60') coincidePrecio = precio > 60;

      if (coincideCategoria && coincideSubcategoria && coincideBusqueda && coincideStock && coincideTab && coincidePrecio) {
        tarjeta.style.display = '';
        visibles++;
      } else {
        tarjeta.style.display = 'none';
      }
    });

    // Ordenamiento Sercoplus
    if (grilla && ordenActual !== 'destacados') {
      const tarjetasArray = Array.from(grilla.children);
      tarjetasArray.sort((a, b) => {
        const precioA = Number(a.getAttribute('data-precio') || 0);
        const precioB = Number(b.getAttribute('data-precio') || 0);
        const nombreA = a.getAttribute('data-nombre') || '';
        const nombreB = b.getAttribute('data-nombre') || '';
        const stockA = Number(a.getAttribute('data-stock') || 0);
        const stockB = Number(b.getAttribute('data-stock') || 0);

        if (ordenActual === 'precio-menor') return precioA - precioB;
        if (ordenActual === 'precio-mayor') return precioB - precioA;
        if (ordenActual === 'nombre') return nombreA.localeCompare(nombreB);
        if (ordenActual === 'stock') return stockB - stockA;
        return 0;
      });
      tarjetasArray.forEach(el => grilla.appendChild(el));
    }

    if (contadorVisibles) {
      contadorVisibles.textContent = `Mostrando ${visibles} productos`;
    }

    if (sinResultados && grilla) {
      if (visibles === 0) {
        sinResultados.classList.remove('hidden');
        grilla.classList.add('hidden');
      } else {
        sinResultados.classList.add('hidden');
        grilla.classList.remove('hidden');
      }
    }

    actualizarBreadcrumbs();
  }

  function fijarFiltro(categoriaId, subcategoriaNombre = '') {
    filtroCategoriaActual = categoriaId;
    filtroSubcategoriaActual = subcategoriaNombre;

    // Actualizar clase en sidebar
    document.querySelectorAll('.item-sidebar-cat').forEach(btn => {
      const id = btn.getAttribute('data-filtro-sidebar');
      if (id === categoriaId) {
        btn.classList.add('active', 'bg-red-50', 'text-[#e52e2e]');
        btn.classList.remove('text-slate-700');
      } else {
        btn.classList.remove('active', 'bg-red-50', 'text-[#e52e2e]');
        btn.classList.add('text-slate-700');
      }
    });

    actualizarSubcategoriasChips();
    aplicarFiltrosYOrden();
  }

  // Sidebar Clicks
  document.querySelectorAll('.item-sidebar-cat').forEach(btn => {
    btn.addEventListener('click', () => {
      const catId = btn.getAttribute('data-filtro-sidebar') || 'todas';
      fijarFiltro(catId, '');
      document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.getElementById('btn-ver-todas-categorias-sidebar')?.addEventListener('click', () => {
    document.getElementById('btn-trigger-categorias')?.click();
  });

  // Evento global desde Header
  window.addEventListener('catalogo:categoria', (e) => {
    const catId = String(e.detail?.categoriaId || 'todas');
    const subNom = String(e.detail?.subcategoria || '');
    fijarFiltro(catId, subNom);
    document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
  });

  window.addEventListener('catalogo:buscar', (e) => {
    terminoBusquedaActual = e.detail?.query || '';
    aplicarFiltrosYOrden();
  });

  // Breadcrumbs
  bInicio?.addEventListener('click', () => fijarFiltro('todas', ''));
  bCat?.addEventListener('click', () => fijarFiltro(filtroCategoriaActual, ''));
  btnLimpiarActivo?.addEventListener('click', () => fijarFiltro('todas', ''));

  // Quick searches
  document.querySelectorAll('[data-quick-search]').forEach(btn => {
    btn.addEventListener('click', () => {
      const term = btn.getAttribute('data-quick-search') || '';
      terminoBusquedaActual = term;
      if (inputBuscador) inputBuscador.value = term;
      fijarFiltro('todas', '');
      document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Tabs Sercoplus
  document.querySelectorAll('.tab-filtro-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-filtro-btn').forEach(b => {
        b.classList.remove('active', 'bg-[#e52e2e]', 'text-white');
        b.classList.add('bg-slate-100', 'text-slate-700');
      });
      btn.classList.add('active', 'bg-[#e52e2e]', 'text-white');
      btn.classList.remove('bg-slate-100', 'text-slate-700');

      tabActual = btn.getAttribute('data-tab-filtro') || 'todos';
      aplicarFiltrosYOrden();
    });
  });

  // Controles
  selectPrecio?.addEventListener('change', (e) => {
    rangoPrecioActual = e.target.value;
    aplicarFiltrosYOrden();
  });

  checkSoloStock?.addEventListener('change', (e) => {
    soloStockActual = e.target.checked;
    aplicarFiltrosYOrden();
  });

  selectOrden?.addEventListener('change', (e) => {
    ordenActual = e.target.value;
    aplicarFiltrosYOrden();
  });

  document.getElementById('btn-limpiar-filtros-vacio')?.addEventListener('click', () => {
    terminoBusquedaActual = '';
    soloStockActual = false;
    tabActual = 'todos';
    ordenActual = 'destacados';
    rangoPrecioActual = 'todos';

    if (inputBuscador) inputBuscador.value = '';
    if (checkSoloStock) checkSoloStock.checked = false;
    if (selectOrden) selectOrden.value = 'destacados';
    if (selectPrecio) selectPrecio.value = 'todos';

    fijarFiltro('todas', '');
  });

  // Inicializar subcategorías
  actualizarSubcategoriasChips();
</script>
