---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import type { InfoTienda, CategoriaCatalogo } from '../lib/catalogo/tipos';

interface Props {
  title: string;
  description?: string;
  tienda: InfoTienda;
  categorias?: CategoriaCatalogo[];
}

const { title, description = 'Catálogo virtual oficial de FOTOSALBERTH - Tecnología, Fotografía y Librería en Trujillo', tienda, categorias = [] } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {tienda.nombre} - Tienda Tecno</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${tienda.nombre}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#15803d" />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 selection:bg-emerald-200">
    <!-- Header Corporativo -->
    <Header tienda={tienda} categorias={categorias} />

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>

    <!-- Footer Estilo Retail Corporativo -->
    <footer class="bg-white border-t border-slate-200 mt-16 pt-12 pb-8 text-sm text-slate-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-100">
          
          <!-- Columna 1: Marca y Propósito -->
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center font-black text-sm">
                FA
              </div>
              <span class="font-black text-slate-900 text-base tracking-tight">FOTOS<span class="text-emerald-700">ALBERTH</span></span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">
              Tu tienda de confianza en Trujillo para tecnología, conectividad, audio, librería e insumos de impresión. Atención directa y garantía de taller.
            </p>
            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-700">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Atención activa en Trujillo</span>
            </div>
          </div>

          <!-- Columna 2: Departamentos -->
          <div class="space-y-2">
            <h4 class="font-extrabold text-xs uppercase tracking-wider text-slate-900">Departamentos</h4>
            <ul class="text-xs space-y-1.5 text-slate-600">
              <li>• Cables & Conectividad</li>
              <li>• Parlantes, Radios & Audio</li>
              <li>• Útiles Escolares & Oficina</li>
              <li>• Tintas & Insumos de Impresión</li>
              <li>• Cargadores & Baterías</li>
              <li>• Mouse, Teclados & Memorias</li>
            </ul>
          </div>

          <!-- Columna 3: Formas de Pago -->
          <div class="space-y-2">
            <h4 class="font-extrabold text-xs uppercase tracking-wider text-slate-900">Métodos de Pago</h4>
            <p class="text-xs text-slate-500">Paga con total seguridad al recibir o coordinar por WhatsApp:</p>
            <div class="flex flex-wrap gap-2 pt-1">
              <span class="px-2.5 py-1 bg-purple-50 text-purple-700 border border-purple-200 rounded-md font-bold text-xs">Yape</span>
              <span class="px-2.5 py-1 bg-cyan-50 text-cyan-700 border border-cyan-200 rounded-md font-bold text-xs">Plin</span>
              <span class="px-2.5 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-md font-bold text-xs">BCP</span>
              <span class="px-2.5 py-1 bg-sky-50 text-sky-700 border border-sky-200 rounded-md font-bold text-xs">BBVA</span>
              <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-md font-bold text-xs">Efectivo</span>
            </div>
          </div>

          <!-- Columna 4: Ubicación y Contacto -->
          <div class="space-y-2">
            <h4 class="font-extrabold text-xs uppercase tracking-wider text-slate-900">Tienda Física & Contacto</h4>
            <p class="text-xs text-slate-600">
              📍 <strong>Trujillo, La Libertad, Perú</strong><br />
              Entregas a domicilio y recojo presencial en taller.
            </p>
            <a
              href="https://wa.me/51987654321"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-2 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Consultas WhatsApp</span>
            </a>
          </div>

        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
          <p>© {new Date().getFullYear()} <strong>{tienda.nombre}</strong> — Todos los derechos reservados.</p>
          <p class="text-slate-400">Catálogo interactivo con tecnología de alta velocidad Cloudflare Workers.</p>
        </div>
      </div>
    </footer>

    <!-- Botón Flotante Asesor WhatsApp (Atención al Cliente) -->
    <a
      href="https://wa.me/51987654321?text=Hola%20FotosAlberth%2C%20tengo%20una%20consulta%20sobre%20un%20producto"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-5 right-5 z-40 bg-emerald-600 hover:bg-emerald-700 text-white p-3.5 rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 flex items-center gap-2 group hover:scale-105 active:scale-95 cursor-pointer"
      aria-label="Contactar por WhatsApp"
      title="¿Dudas o pedidos especiales? Escríbenos a WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span class="max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs transition-all duration-300 text-xs font-extrabold pl-0 group-hover:pl-1">
        ¿Dudas? Chatea con nosotros
      </span>
    </a>

    <!-- Carrito Lateral Deslizable -->
    <CartDrawer tienda={tienda} />
  </body>
</html>
