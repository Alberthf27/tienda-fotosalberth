---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import type { InfoTienda } from '../lib/catalogo/tipos';
import type { CategoriaConSubcategorias } from '../lib/catalogo/taxonomia';

interface Props {
  title: string;
  description?: string;
  tienda: InfoTienda;
  taxonomia: CategoriaConSubcategorias[];
}

const {
  title,
  description = 'Catálogo virtual oficial de FOTOSALBERTH - Tecnología, Cómputo, Audio y Fotografía en Trujillo. Pedidos directos con entrega inmediata.',
  tienda,
  taxonomia = []
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {tienda.nombre} - Tienda Tecno</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${tienda.nombre}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#e52e2e" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#f5f6f9] text-slate-800 antialiased selection:bg-red-200 pb-16 md:pb-0">
    
    <!-- Header Oficial Sercoplus -->
    <Header tienda={tienda} taxonomia={taxonomia} />

    <!-- Contenedor de Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <slot />
    </main>

    <!-- Footer Oficial Estilo Retail Sercoplus -->
    <footer class="bg-white border-t border-slate-200 mt-16 pt-12 pb-12 text-xs text-slate-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-100">
          
          <!-- Identidad y Respaldo -->
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-[#e52e2e] text-white flex items-center justify-center font-black text-sm">
                FA
              </div>
              <span class="font-black text-slate-900 text-base tracking-tight">FOTOS<span class="text-[#e52e2e]">ALBERTH</span></span>
            </div>
            <p class="text-[12px] text-slate-500 leading-relaxed">
              Corporación de tecnología, conectividad, audio, librería y servicios fotográficos en Trujillo. Stock físico garantizado con más de una década de experiencia.
            </p>
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-emerald-700">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Atención activa en Trujillo • Envíos el mismo día</span>
            </div>
          </div>

          <!-- Departamentos Sercoplus -->
          <div class="space-y-2">
            <h4 class="font-black text-[11px] uppercase tracking-wider text-slate-900">Departamentos</h4>
            <ul class="space-y-1.5 text-slate-600">
              <li>• Cables & Conectividad</li>
              <li>• Parlantes, Radios & Audio</li>
              <li>• Audífonos Bluetooth & Gamer</li>
              <li>• Tintas & Insumos de Impresión</li>
              <li>• Cargadores & Baterías</li>
              <li>• Útiles Escolares & Oficina</li>
            </ul>
          </div>

          <!-- Métodos de Pago Seguros -->
          <div class="space-y-2">
            <h4 class="font-black text-[11px] uppercase tracking-wider text-slate-900">Medios de Pago</h4>
            <p class="text-[12px] text-slate-500">Paga con total seguridad contraentrega o previo envío:</p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              <span class="px-2.5 py-1 bg-purple-50 text-purple-700 border border-purple-200 rounded font-bold text-[11px]">Yape</span>
              <span class="px-2.5 py-1 bg-cyan-50 text-cyan-700 border border-cyan-200 rounded font-bold text-[11px]">Plin</span>
              <span class="px-2.5 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded font-bold text-[11px]">BCP</span>
              <span class="px-2.5 py-1 bg-sky-50 text-sky-700 border border-sky-200 rounded font-bold text-[11px]">BBVA</span>
              <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded font-bold text-[11px]">Efectivo</span>
            </div>
          </div>

          <!-- Taller y Ubicación Física -->
          <div class="space-y-2">
            <h4 class="font-black text-[11px] uppercase tracking-wider text-slate-900">Taller & Contacto</h4>
            <p class="text-[12px] text-slate-600 leading-relaxed">
              📍 <strong>Trujillo, La Libertad, Perú</strong><br />
              Entregas a domicilio y recojo presencial en taller.
            </p>
            <a
              href={`https://wa.me/${tienda.telefono_whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 mt-2 px-3.5 py-2 bg-[#e52e2e] hover:bg-[#cc1818] text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
            >
              <span>Consultas por WhatsApp</span>
            </a>
          </div>

        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-2">
          <p>© {new Date().getFullYear()} <strong>{tienda.nombre}</strong> — Todos los derechos reservados.</p>
          <p class="text-slate-500 font-medium">Libro de Reclamaciones disponible en taller físico.</p>
        </div>
      </div>
    </footer>

    <!-- Dock Móvil Flotante Sercoplus -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-slate-200 px-4 py-2 flex items-center justify-around text-slate-600 shadow-lg">
      <button
        type="button"
        id="dock-btn-inicio"
        class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-[#e52e2e] cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Inicio</span>
      </button>

      <button
        type="button"
        id="dock-btn-categorias"
        class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-slate-700 hover:text-[#e52e2e] cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Categorías</span>
      </button>

      <button
        type="button"
        id="dock-btn-buscar"
        class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-slate-700 hover:text-[#e52e2e] cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>Buscar</span>
      </button>

      <button
        type="button"
        id="dock-btn-carrito"
        class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-slate-700 hover:text-[#e52e2e] cursor-pointer relative"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="21" r="1"/>
          <circle cx="19" cy="21" r="1"/>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
        </svg>
        <span
          id="dock-badge-carrito"
          class="hidden absolute -top-1 right-2 min-w-[14px] h-3.5 px-0.5 bg-[#e52e2e] text-white font-black text-[9px] rounded-full items-center justify-center"
        >
          0
        </span>
        <span>Carrito</span>
      </button>
    </nav>

    <!-- Drawer del Carrito -->
    <CartDrawer tienda={tienda} />

    <script>
      document.getElementById('dock-btn-inicio')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('dock-btn-categorias')?.addEventListener('click', () => {
        const btnCat = document.getElementById('btn-trigger-categorias');
        btnCat?.click();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('dock-btn-buscar')?.addEventListener('click', () => {
        const input = document.getElementById('buscador-productos');
        input?.focus();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('dock-btn-carrito')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('cart:open'));
      });

      window.addEventListener('cart:change', ((e: CustomEvent) => {
        const badge = document.getElementById('dock-badge-carrito');
        const count = e.detail?.totalItems || 0;
        if (badge) {
          if (count > 0) {
            badge.textContent = String(count);
            badge.classList.remove('hidden');
            badge.classList.add('flex');
          } else {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
          }
        }
      }) as EventListener);
    </script>
  </body>
</html>
