---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import type { InfoTienda } from '../lib/catalogo/tipos';
import type { CategoriaConSubcategorias } from '../lib/catalogo/taxonomia';

interface Props {
  title: string;
  description?: string;
  tienda: InfoTienda;
  taxonomia: CategoriaConSubcategorias[];
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Catálogo virtual oficial de FOTOSALBERTH - Tecnología, Fotografía y Librería en Trujillo. Pedidos directos con entrega inmediata.',
  tienda,
  taxonomia = [],
  canonical,
  jsonLd
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {tienda.nombre}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | ${tienda.nombre}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={tienda.nombre} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0f172a" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-emerald-100 selection:text-emerald-900 pb-16 md:pb-0">
    
    <!-- Header Principal con Menú Maestro "Categorías" -->
    <Header tienda={tienda} taxonomia={taxonomia} />

    <!-- Contenedor de Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <slot />
    </main>

    <!-- Footer Sobrio con Estilo Apple / Editorial -->
    <footer class="bg-white border-t border-slate-200/80 mt-16 pt-12 pb-12 text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-100">
          
          <!-- Identidad -->
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xs">
                FA
              </div>
              <span class="font-bold text-slate-900 text-sm tracking-tight">FOTOS<span class="text-emerald-700">ALBERTH</span></span>
            </div>
            <p class="text-[12px] text-slate-500 leading-relaxed">
              Fotografía oficial, servicio técnico, conectividad, audio y librería en Trujillo. Catálogo digital en tiempo real con respaldo presencial en taller.
            </p>
            <div class="flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Atención presencial y envíos en Trujillo</span>
            </div>
          </div>

          <!-- Departamentos destacados -->
          <div class="space-y-2">
            <h4 class="font-bold text-[11px] uppercase tracking-wider text-slate-900">Departamentos</h4>
            <ul class="space-y-1.5 text-slate-600">
              <li>• Cables & Conectividad</li>
              <li>• Parlantes, Radios & Audio</li>
              <li>• Audífonos Bluetooth & Gamer</li>
              <li>• Tintas & Insumos de Impresión</li>
              <li>• Cargadores & Baterías</li>
              <li>• Útiles Escolares & Oficina</li>
            </ul>
          </div>

          <!-- Métodos de pago seguros -->
          <div class="space-y-2">
            <h4 class="font-bold text-[11px] uppercase tracking-wider text-slate-900">Métodos de Pago</h4>
            <p class="text-[12px] text-slate-500">Paga con seguridad contraentrega o con confirmación previa:</p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-semibold text-[11px]">Yape</span>
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-semibold text-[11px]">Plin</span>
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-semibold text-[11px]">BCP</span>
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-semibold text-[11px]">BBVA</span>
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-semibold text-[11px]">Efectivo</span>
            </div>
          </div>

          <!-- Taller y Ubicación -->
          <div class="space-y-2">
            <h4 class="font-bold text-[11px] uppercase tracking-wider text-slate-900">Taller & Contacto</h4>
            <p class="text-[12px] text-slate-600 leading-relaxed">
              📍 <strong>Trujillo, La Libertad, Perú</strong><br />
              Entregas a domicilio y coordinación directa por WhatsApp.
            </p>
            <a
              href={`https://wa.me/${tienda.telefono_whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="apple-press inline-flex items-center gap-1.5 mt-2 px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold"
            >
              <span>Consultas por WhatsApp</span>
            </a>
          </div>

        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-2">
          <p>© {new Date().getFullYear()} <strong>{tienda.nombre}</strong> — Todos los derechos reservados.</p>
          <p>Catálogo digital con tecnología Cloudflare Edge Workers.</p>
        </div>
      </div>
    </footer>

    <!-- Barra Dock Flotante Móvil Apple-Style (Fixed Bottom Bar para pantallas pequeñas) -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/90 backdrop-blur-xl border-t border-slate-200/80 px-4 py-2 flex items-center justify-around text-slate-600">
      <button
        type="button"
        id="dock-btn-inicio"
        class="apple-press flex flex-col items-center gap-1 text-[10px] font-semibold text-slate-900 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Inicio</span>
      </button>

      <button
        type="button"
        id="dock-btn-categorias"
        class="apple-press flex flex-col items-center gap-1 text-[10px] font-semibold text-slate-600 hover:text-slate-900 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
        <span>Categorías</span>
      </button>

      <button
        type="button"
        id="dock-btn-buscar"
        class="apple-press flex flex-col items-center gap-1 text-[10px] font-semibold text-slate-600 hover:text-slate-900 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>Buscar</span>
      </button>

      <button
        type="button"
        id="dock-btn-carrito"
        class="apple-press flex flex-col items-center gap-1 text-[10px] font-semibold text-slate-600 hover:text-slate-900 cursor-pointer relative"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="21" r="1"/>
          <circle cx="19" cy="21" r="1"/>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
        </svg>
        <span
          id="dock-badge-carrito"
          class="hidden absolute -top-1 right-2 min-w-[14px] h-3.5 px-0.5 bg-emerald-600 text-white font-bold text-[9px] rounded-full items-center justify-center"
        >
          0
        </span>
        <span>Carrito</span>
      </button>
    </nav>

    <!-- Botón Flotante Asesor WhatsApp (Solo en Desktop) -->
    <a
      href={`https://wa.me/${tienda.telefono_whatsapp}?text=Hola%20FotosAlberth%2C%20tengo%20una%20consulta%20sobre%20un%20producto`}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:flex fixed bottom-6 right-6 z-30 bg-slate-900 hover:bg-slate-800 text-white p-3 rounded-full shadow-lg apple-press items-center gap-2 border border-slate-700/50"
      aria-label="Contactar por WhatsApp"
      title="¿Consultas? Escríbenos directamente"
    >
      <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
      <span class="text-xs font-semibold pr-1">WhatsApp</span>
    </a>

    <!-- Drawer del Carrito -->
    <CartDrawer tienda={tienda} />

    <script>
      // Conexión del Dock Móvil
      document.getElementById('dock-btn-inicio')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('dock-btn-categorias')?.addEventListener('click', () => {
        const btnCat = document.getElementById('btn-trigger-categorias');
        btnCat?.click();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('dock-btn-buscar')?.addEventListener('click', () => {
        const input = document.getElementById('buscador-productos');
        input?.focus();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('dock-btn-carrito')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('cart:open'));
      });

      window.addEventListener('cart:change', ((e: CustomEvent) => {
        const badge = document.getElementById('dock-badge-carrito');
        const count = e.detail?.totalItems || 0;
        if (badge) {
          if (count > 0) {
            badge.textContent = String(count);
            badge.classList.remove('hidden');
            badge.classList.add('flex');
          } else {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
          }
        }
      }) as EventListener);
    </script>
  </body>
</html>
